# Local / generated Terraform artifacts — never commit
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.auto.tfvars
terraform.tfvars
!terraform.tfvars.example
!example.tfvars
secrets.tfvars
.terraform.tfstate.lock.info

# Module test working dirs / accidental local locks (root lock files are committed)
modules/*/.terraform/
modules/*/.terraform.lock.hcl
